{
  "name": "lantern-sdk-workspace",
  "version": "4.0.0",
  "description": "Workspace for @northgate/lantern-sdk, the Angular wrapper around the Lumenview Lantern vendor script. Digital Analytics Enablement.",
  "private": true,
  "engines": {
    "node": "14.21.3",
    "npm": "6.14.18"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build lantern-sdk --configuration production",
    "build:dev": "ng build lantern-sdk --configuration development",
    "watch": "ng build lantern-sdk --watch --configuration development",
    "test": "ng test lantern-sdk --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test lantern-sdk",
    "lint": "ng lint lantern-sdk",
    "pack": "npm run build && cd dist/lantern-sdk && npm pack",
    "verify:partial-ivy": "node scripts/verify-partial-ivy.js",
    "publish:local": "bash scripts/publish.sh"
  },
  "dependencies": {
    "@angular/animations": "14.3.0",
    "@angular/common": "14.3.0",
    "@angular/compiler": "14.3.0",
    "@angular/core": "14.3.0",
    "@angular/forms": "14.3.0",
    "@angular/platform-browser": "14.3.0",
    "@angular/platform-browser-dynamic": "14.3.0",
    "@angular/router": "14.3.0",
    "rxjs": "6.6.7",
    "tslib": "2.3.1",
    "zone.js": "0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "14.2.13",
    "@angular-eslint/builder": "14.4.0",
    "@angular-eslint/eslint-plugin": "14.4.0",
    "@angular-eslint/eslint-plugin-template": "14.4.0",
    "@angular-eslint/schematics": "14.4.0",
    "@angular-eslint/template-parser": "14.4.0",
    "@angular/cli": "14.2.13",
    "@angular/compiler-cli": "14.3.0",
    "@types/jasmine": "3.8.2",
    "@types/node": "16.18.11",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "eslint": "8.57.1",
    "jasmine-core": "3.8.0",
    "karma": "6.3.20",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.0.3",
    "karma-jasmine": "4.0.2",
    "karma-jasmine-html-reporter": "1.7.0",
    "ng-packagr": "14.2.2",
    "typescript": "4.7.4"
  }
}
