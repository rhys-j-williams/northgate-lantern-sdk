{
  "name": "lantern-sdk-workspace",
  "version": "3.0.0",
  "description": "Workspace for @northgate/lantern-sdk, the Angular wrapper around the Lumenview Lantern vendor script. Digital Analytics Enablement.",
  "private": true,
  "engines": {
    "node": "14.21.3",
    "npm": "6.14.18"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build lantern-sdk --configuration production",
    "build:dev": "ng build lantern-sdk --configuration development",
    "watch": "ng build lantern-sdk --watch --configuration development",
    "test": "ng test lantern-sdk --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test lantern-sdk",
    "lint": "tslint -p tsconfig.json -c tslint.json 'projects/**/*.ts'",
    "pack": "npm run build && cd dist/lantern-sdk && npm pack",
    "verify:partial-ivy": "node scripts/verify-partial-ivy.js",
    "publish:local": "bash scripts/publish.sh"
  },
  "dependencies": {
    "@angular/animations": "13.4.0",
    "@angular/common": "13.4.0",
    "@angular/compiler": "13.4.0",
    "@angular/core": "13.4.0",
    "@angular/forms": "13.4.0",
    "@angular/platform-browser": "13.4.0",
    "@angular/platform-browser-dynamic": "13.4.0",
    "@angular/router": "13.4.0",
    "rxjs": "6.6.7",
    "tslib": "2.3.1",
    "zone.js": "0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "13.3.11",
    "@angular/cli": "13.3.11",
    "@angular/compiler-cli": "13.4.0",
    "@types/jasmine": "3.8.2",
    "@types/node": "16.18.11",
    "codelyzer": "6.0.2",
    "jasmine-core": "3.8.0",
    "karma": "6.3.20",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.0.3",
    "karma-jasmine": "4.0.2",
    "karma-jasmine-html-reporter": "1.7.0",
    "ng-packagr": "13.3.1",
    "tslint": "6.1.3",
    "typescript": "4.6.4"
  }
}
